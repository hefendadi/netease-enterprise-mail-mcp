# Fictional configuration only. Copy to .env beside index.js.
# Replace these values with your own administrator-approved credentials.
# Process environment values take precedence over .env.
EMAIL_USER=reader@example.com
EMAIL_PASSWORD="replace-with-your-own-client-authorization-code"
EMAIL_TYPE=netease-enterprise

# Optional: confirm your tenant's IMAP host and port with its administrator.
# EMAIL_IMAP_HOST=imaphz.qiye.163.com
# EMAIL_IMAP_PORT=993

# Optional SMTP overrides (connection checks or explicitly enabled sending).
# EMAIL_SMTP_HOST=smtphz.qiye.163.com
# EMAIL_SMTP_PORT=465

# Use a trusted, private POSIX directory with no symlink path components.
# An explicitly configured unsafe/unwritable directory fails without fallback.
# EMAIL_ATTACHMENT_DIR=/absolute/path/to/private-attachments

# Keep these unset for default read-only operation and TLS protection:
# ENABLE_WRITE_TOOLS
# EMAIL_IMAP_SECURE
# IMAP_TLS_REJECT_UNAUTHORIZED
